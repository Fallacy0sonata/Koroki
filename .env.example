# Koroki 2.0 - Environment Configuration
# Copy this to .env and fill in your values before starting.
# Python runtime policy: use a Python 3.12 virtual environment for this repo.

# --- Paths ---
# Absolute path to the repo root. Used by services to find config/settings.yaml.
KOROKI_ROOT=C:/Users/Shinn/Desktop/Koroki

# --- Discord Bot ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here
OWNER_DISCORD_ID=your_own_discord_user_id_here

# --- Internal Security ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=replace_with_secure_random_key

# --- Optional: HuggingFace token (required for gated models) ---
HF_TOKEN=

# --- Optional: Override service URLs (defaults match settings.yaml) ---
ORCHESTRATOR_URL=http://127.0.0.1:9882
BRAIN_URL=http://127.0.0.1:9881
TTS_URL=http://127.0.0.1:9880
